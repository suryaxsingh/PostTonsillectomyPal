function roundToNearestHalf(value) {
  return Math.round(value * 2) / 2;
}

function formatMl(value) {
  if (value === null || value === undefined) return "";
  if (Number.isInteger(value)) return `${value} mL`;
  return `${value.toFixed(1)} mL`;
}

function formatDate(date) {
  if (!date) return "";
  const d = String(date.getDate()).padStart(2, "0");
  const m = String(date.getMonth() + 1).padStart(2, "0");
  const y = date.getFullYear();
  return `${d}/${m}/${y}`;
}

function getPostOpDay(surgeryDate) {
  if (!surgeryDate) return null;

  const today = new Date();
  const todayOnly = new Date(today.getFullYear(), today.getMonth(), today.getDate());
  const surgeryOnly = new Date(
    surgeryDate.getFullYear(),
    surgeryDate.getMonth(),
    surgeryDate.getDate()
  );

  const diffMs = todayOnly.getTime() - surgeryOnly.getTime();
  return Math.max(0, Math.floor(diffMs / (1000 * 60 * 60 * 24)));
}
function getRecoveryInfo(postOpDay) {
  if (postOpDay === null || postOpDay === undefined) {
    return {
      title: "Recovery guidance",
      message: "Choose the surgery date to see day-by-day recovery guidance.",
    };
  }

  if (postOpDay >= 14) {
    return RECOVERY_DAYS[14];
  }

  return RECOVERY_DAYS[postOpDay] || RECOVERY_DAYS[0];
}
function calculateLiquidDose(med, weightKg, strengthMgPerMl) {
  const weight = Number(weightKg);

  if (!weight || weight <= 0 || !strengthMgPerMl) {
    return {
      doseMg: null,
      doseMl: null,
      capped: false,
    };
  }

  const rawMg = weight * med.mgPerKg;
  const cappedMg = Math.min(rawMg, med.maxSingleDoseMg);
  const rawMl = cappedMg / strengthMgPerMl;

  return {
    doseMg: Math.round(cappedMg),
    doseMl: roundToNearestHalf(rawMl),
    capped: rawMg > med.maxSingleDoseMg,
  };
}

function parseTimeToMinutes(timeText) {
  const match = /^([01]?\d|2[0-3]):([0-5]\d)$/.exec(timeText.trim());
  if (!match) return null;

  return Number(match[1]) * 60 + Number(match[2]);
}

function formatMinutes(totalMinutes) {
  const minutesInDay = 24 * 60;
  const clean = ((totalMinutes % minutesInDay) + minutesInDay) % minutesInDay;

  const h24 = Math.floor(clean / 60);
  const mins = clean % 60;
  const suffix = h24 >= 12 ? "PM" : "AM";
  const h12 = h24 % 12 === 0 ? 12 : h24 % 12;

  return `${h12}:${String(mins).padStart(2, "0")} ${suffix}`;
}

function makeNextDoseForMed(med, settings) {
  const first = parseTimeToMinutes(settings.firstTime || "");
  if (first === null) return null;

  const nextDue = first + med.intervalHours * 60;

  return {
    doseNumber: 2,
    dueMinutes: nextDue,
    displayTime: formatMinutes(nextDue),
  };
}

function currentTime24h() {
  const now = new Date();
  return `${String(now.getHours()).padStart(2, "0")}:${String(
    now.getMinutes()
  ).padStart(2, "0")}`;
}

